POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing

# Host port for Postgres; 5433 avoids clashing with a local Postgres on 5432.
DB_PORT=5433

# Used when running the API on the host; compose builds its own URL with host "db".
DATABASE_URL=postgres://ticketing:ticketing@localhost:5433/ticketing?sslmode=disable

HTTP_PORT=8080

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h